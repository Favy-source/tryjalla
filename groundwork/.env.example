# Groundwork by Jalla — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is in .gitignore.

# ── Supabase (local dev) ──────────────────────────────────────────────
# Get these from `npx supabase start` output
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key-here

# ── Google OAuth ──────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback  (local)
#                          https://your-project.supabase.co/auth/v1/callback  (prod)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# ── Resend (email) ────────────────────────────────────────────────────
# Used by edge functions — NOT exposed to the browser (no VITE_ prefix)
RESEND_API_KEY=

# ── Supabase service role (edge functions only) ───────────────────────
# NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here
